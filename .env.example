# Knowledge Researcher model, as provider/model-name.
# Providers Mastra lists need only the model and key:
#   zai/glm-5.3-flash, deepseek/deepseek-v4-flash, opencode/glm-5.3-flash, anthropic/claude-sonnet-5-5
KNOWLEDGE_RESEARCHER_MODEL=zai/glm-5.3-flash

# API key for whichever provider serves the model above. Required with KNOWLEDGE_RESEARCHER_MODEL_URL.
KNOWLEDGE_RESEARCHER_API_KEY=your-provider-api-key

# Optional: an OpenAI-compatible endpoint, for providers Mastra does not list (for example Nous Portal).
# With it set, the part of the model before the first slash is only a label, e.g. nous/<model-name>.
# KNOWLEDGE_RESEARCHER_MODEL_URL=https://inference-api.nousresearch.com/v1
