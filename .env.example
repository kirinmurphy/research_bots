# Knowledge Researcher model, as a Mastra model-router string (provider/model-name).
# Examples: zai/glm-5.3-flash, deepseek/deepseek-v4-flash, anthropic/claude-sonnet-5-5
KNOWLEDGE_RESEARCHER_MODEL=zai/glm-5.3-flash

# API key for whichever provider the model above names.
KNOWLEDGE_RESEARCHER_API_KEY=your-provider-api-key
