# ─── Model provider ─────────────────────────────────────────────────────────
# One provider and key serve every agent.

# API key for the provider. Required when MODEL_BASE_URL is set.
MODEL_API_KEY=your-provider-api-key

# Optional: an OpenAI-compatible endpoint, for providers Mastra does not list
# (for example Nous Portal). Leave it unset for listed providers such as
# zai, deepseek, or opencode. Confirm the URL in your provider's dashboard.
MODEL_BASE_URL=https://inference-api.nousresearch.com/v1

# ─── Models by use case ─────────────────────────────────────────────────────
# Each value is provider/model-name. With MODEL_BASE_URL set, the provider
# part is only a label (nous/...) and the rest is sent as the model name.
# Prefer a pinned model id over a "latest" alias, so answers do not change
# when the provider updates the alias.

# Knowledge Researcher: primary research, strategy analysis, prioritization.
RESEARCH_MODEL=nous/your-glm-flash-model-id

# Not used yet. Each line takes effect when its feature is built.
# Second opinion on important decisions (review agent).
# REVIEW_MODEL=nous/your-deepseek-flash-model-id
# Complex research and build-vs-buy decisions (strategy agent).
# STRATEGY_MODEL=nous/your-qwen-flash-model-id
# Bulk categorization of large transcript collections.
# CATEGORIZATION_MODEL=nous/your-ling-flash-model-id
